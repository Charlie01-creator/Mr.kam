# Copy to .env and fill in. NEVER commit .env.
# Pooled connection string (Neon/Supabase pooler) used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Direct (non-pooled) connection used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
SITE_URL="http://localhost:3000"
# First admin, used only by `npm run db:seed`. Use a strong password, then change it.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional until configured: email, image storage, WhatsApp (digits only, e.g. 2567XXXXXXXX)
EMAIL_PROVIDER_API_KEY=""
IMAGE_STORAGE_TOKEN=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
